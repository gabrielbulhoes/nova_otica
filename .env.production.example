# ─────────────────────────────────────────────────────────────────────────────
# Nova Ótica · variáveis de PRODUÇÃO (VPS)
#
# Copie para `.env` NA VPS — nunca versione o arquivo preenchido. O repositório
# é público, e este arquivo, com valores reais, dá acesso ao banco da rede e à
# API da CDS.
#
#   cp .env.production.example .env && chmod 600 .env && nano .env
#
# Gere os segredos com:  openssl rand -base64 36
# ─────────────────────────────────────────────────────────────────────────────

# ── Endereço público ─────────────────────────────────────────────────────────
DOMINIO=app.novaotica.gb.app.br
ACME_EMAIL=gabrielbulhoes@gmail.com
# Origem exata do navegador. A API recusa curinga em produção, de propósito:
# CORS aberto num painel com estoque e faturamento da rede não tem justificativa.
WEB_ORIGIN=https://app.novaotica.gb.app.br

# ── Banco ────────────────────────────────────────────────────────────────────
POSTGRES_USER=nova_otica
POSTGRES_DB=nova_otica
# OBRIGATÓRIO. Sem isto o compose se recusa a subir.
POSTGRES_PASSWORD=

# ── Sessão ───────────────────────────────────────────────────────────────────
# >= 24 caracteres. Trocar este valor invalida todas as sessões abertas.
JWT_SECRET=

# ── Primeiro acesso ──────────────────────────────────────────────────────────
# Conta criada na primeira subida. TROQUE A SENHA no primeiro login.
SEED_ADMIN_EMAIL=admin@novaotica.com
SEED_ADMIN_PASSWORD=

# ── Integração CDS / Sellbie ─────────────────────────────────────────────────
# Comece em `mock`: a rede sobe, o console funciona e nada toca o ERP. Só vire
# para `live` DEPOIS de rotacionar as credenciais e liberar o IP da VPS na
# allowlist da Sellbie (ver o runbook, §7).
SELLBIE_MODE=mock
SELLBIE_BASE_URL=
SELLBIE_API_KEY=
SELLBIE_API_TOKEN=
SELLBIE_CLIENT_ID=
# Janela em que o ERP aceita extração pesada, combinada com a Sellbie.
SELLBIE_WINDOW_START=06:00
SELLBIE_WINDOW_END=07:00

# ── Sincronização ────────────────────────────────────────────────────────────
# Lote diário. `0 6 * * *` = 6h da manhã no fuso abaixo.
SYNC_CRON=0 6 * * *
# Roda um sync ao subir. Útil no primeiro deploy; depois pode ficar `false`
# para um `restart` não disparar extração fora da janela.
SYNC_ON_BOOT=true
TZ=America/Recife

# ── Backup ───────────────────────────────────────────────────────────────────
# Dias de retenção dos dumps diários no volume `backups`.
BACKUP_RETENTION_DAYS=14
