# ─────────────────────────────────────────────────────────────────────────────
# Nova Ótica · variáveis de PRODUÇÃO (VPS)
#
# Copie para `.env` NA VPS — nunca versione o arquivo preenchido. O repositório
# é público, e este arquivo, com valores reais, dá acesso ao banco da rede e à
# API da CDS.
#
#   cp .env.production.example .env && chmod 600 .env && nano .env
#
# Gere os segredos com:  openssl rand -base64 36
# ─────────────────────────────────────────────────────────────────────────────

# ── Endereço público ─────────────────────────────────────────────────────────
DOMINIO=app.novaotica.gb.app.br
ACME_EMAIL=gabrielbulhoes@gmail.com
# Origem exata do navegador. A API recusa curinga em produção, de propósito:
# CORS aberto num painel com estoque e faturamento da rede não tem justificativa.
WEB_ORIGIN=https://app.novaotica.gb.app.br

# ── Banco ────────────────────────────────────────────────────────────────────
POSTGRES_USER=nova_otica
POSTGRES_DB=nova_otica
# OBRIGATÓRIO. Sem isto o compose se recusa a subir.
POSTGRES_PASSWORD=

# ── Sessão ───────────────────────────────────────────────────────────────────
# >= 24 caracteres. Trocar este valor invalida todas as sessões abertas.
JWT_SECRET=

# ── Primeiro acesso ──────────────────────────────────────────────────────────
# Conta criada na primeira subida. TROQUE A SENHA no primeiro login.
SEED_ADMIN_EMAIL=admin@novaotica.com
SEED_ADMIN_PASSWORD=

# ── Integração CDS / Sellbie ─────────────────────────────────────────────────
# Comece em `mock`: a rede sobe, o console funciona e nada toca o ERP. Só vire
# para `live` DEPOIS de rotacionar as credenciais e liberar o IP da VPS na
# allowlist da Sellbie (ver o runbook, §7).
SELLBIE_MODE=mock
SELLBIE_BASE_URL=
SELLBIE_API_KEY=
SELLBIE_API_TOKEN=
SELLBIE_CLIENT_ID=
# Janela em que o ERP aceita extração pesada, combinada com a Sellbie.
SELLBIE_WINDOW_START=06:00
SELLBIE_WINDOW_END=07:00

# ── Truncamento silencioso do conector ───────────────────────────────────────
# O conector CDS não tem paginação: nenhuma rota aceita page/limit/offset. Ele
# corta a resposta num teto que não documenta e NÃO avisa — na carga de
# 04/08/2026 uma chamada só a cds/produtos devolveu 5.318 dos ~21.683 produtos
# da rede. O contorno é fatiar a faixa de datas até cada resposta caber.
#
# Respostas com pelo menos este número de linhas são tratadas como truncadas.
# Se o catálogo AINDA vier curto, baixe (2000, 1000): fatiar demais custa
# chamadas, aceitar um truncamento custa catálogo.
SELLBIE_PAGE_LIMIT=4000
# Piso da varredura do catálogo. 1900-01-01 de propósito: é o placeholder de
# data-nula do conector, e um piso em 2000 excluiria produto sem data.
SELLBIE_CATALOG_START=1900-01-01
# Teto de chamadas por varredura (trava contra fatiamento descontrolado).
SELLBIE_SWEEP_MAX_CALLS=400
# Produtos por chamada em cds/estoquegrade — a rota não tem filtro de data, o
# que ela aceita é `cod_prod` como lista CSV. Se o conector recusar o lote, o
# sync o parte ao meio sozinho até achar um tamanho aceito; este número é só
# o ponto de partida.
SELLBIE_STOCK_CHUNK=250
# Teto DURO do cds/estoquegrade. Cada filial devolveu exatas 50.000 linhas em
# 04/08/2026, sem aviso. Acima deste número a leitura da filial é dada como
# cortada e a zeragem das posições sem saldo é PULADA — o que não veio pode ter
# sido truncado, não zerado, e zerar aí apagaria estoque real.
SELLBIE_STOCK_HARD_CAP=20000
# Janela de vendas do lote diário, em dias. O padrão do conector é "o último
# mês", mas implícito — e o que não tem faixa explícita não pode ser fatiado
# quando vem truncado. 35 dá folga se um dia de sync falhar.
SELLBIE_SALES_WINDOW_DAYS=35

# ── Alertas operacionais ─────────────────────────────────────────────────────
# SEM PELO MENOS UM CANAL AQUI, A FALHA DO SYNC É SILENCIOSA. O lote das 6h é
# o coração da operação: se ele parar, o console continua abrindo e mostrando
# os números da véspera como se fossem de hoje — que é o pior modo de falha
# possível, porque se parece com funcionamento normal.
#
# Telegram é o caminho mais curto (é onde a operação já vive):
#   1. fale com @BotFather no Telegram e crie um bot -> ele devolve o token
#   2. adicione o bot ao grupo e mande qualquer mensagem
#   3. abra https://api.telegram.org/bot<TOKEN>/getUpdates e copie o chat.id
#      (grupo tem id NEGATIVO, ex.: -1001234567890 — copie com o sinal)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Alternativa/adicional: webhook JSON genérico (Slack, Discord, n8n, Zapier).
# O payload traz um campo `text` já legível, sem precisar de template.
ALERT_WEBHOOK_URL=
# Horas sem sync BEM-SUCEDIDO antes de a base ser dada como vencida. 26 e não
# 24: o lote é diário, e um atraso de duas horas não é incidente.
SYNC_STALE_HOURS=26
# Quando o vigia confere. 09:00 — três horas depois do lote, cedo o bastante
# para alguém agir antes de a rede abrir por completo.
SYNC_WATCHDOG_CRON=0 9 * * *
# BATIMENTO: o vigia também avisa quando a base está EM DIA, uma vez por
# rodada. Deixe ligado.
#
# O vigia roda dentro do mesmo processo que ele vigia: contêiner parado derruba
# os dois de uma vez, e a ausência de alerta fica idêntica à saúde — que é
# justamente o modo de falha que o vigia existe para cobrir. Sem batimento, o
# canal só sabe dizer "há um problema"; nunca "estou vivo", e um silêncio de
# dois dias pode ser tanto "tudo certo" quanto "morri na segunda".
#
# Com ele, o silêncio passa a ser o alarme: se a mensagem das 09:00 não chegar,
# alguma coisa parou. Custa uma mensagem por dia.
SYNC_HEARTBEAT=true

# ── Sincronização ────────────────────────────────────────────────────────────
# Lote diário. `0 6 * * *` = 6h da manhã no fuso abaixo.
SYNC_CRON=0 6 * * *
# Roda um sync ao subir. Útil no primeiro deploy; depois pode ficar `false`
# para um `restart` não disparar extração fora da janela.
SYNC_ON_BOOT=true
TZ=America/Recife

# ── Backup ───────────────────────────────────────────────────────────────────
# Dias de retenção dos dumps diários no volume `backups`.
BACKUP_RETENTION_DAYS=14
