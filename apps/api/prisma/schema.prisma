// Nova Ótica — modelo de dados
// Espelha as entidades da API Sellbie/CDS e adiciona a camada de
// movimentação interna (transferências/ajustes) usada em tempo real
// durante o dia, reconciliada a cada sincronização da manhã (06:00-07:00).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Cadastros base ──────────────────────────────────────────────────────────

/// Loja / filial da rede (Sellbie: rota `lojas`, campo `idFilial`).
model Store {
  id         String  @id @default(cuid())
  externalId String  @unique // idFilial
  code       String? // código interno da filial
  name       String
  city       String?
  state      String?
  phone      String?
  active     Boolean @default(true)

  // Centro de distribuição (ex.: GMAIS) e outras filiais que não devem entrar
  // na matemática de planejamento (remanejamento, compra, ruptura, cobertura).
  // Continuam no cadastro/histórico, mas ficam fora das contas das lojas.
  excludeFromPlanning Boolean @default(false)

  // Filial que opera em OUTRO ERP (ZEISS VISION CENTER): o CDS até devolve
  // dados dela, mas desatualizados. Fica fora de todo número da plataforma —
  // planejamento, BI, relatórios e painel.
  //
  // É um campo separado de `excludeFromPlanning` de propósito: aquele significa
  // "retaguarda da rede" e o painel soma essas unidades sob esse rótulo. Juntar
  // os dois faria uma loja de varejo aparecer como centro de distribuição.
  externalErp Boolean @default(false)

  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  stockItems    StockItem[]
  sales         Sale[]
  sellers       Seller[]
  users         User[]
  carts         Cart[]
  orders        Order[]
  movementsFrom InventoryMovement[] @relation("MovementFromStore")
  movementsTo   InventoryMovement[] @relation("MovementToStore")
  decisions     DecisionRecord[]

  @@index([active])
  @@index([excludeFromPlanning])
  @@index([externalErp])
  @@index([excludeFromPlanning, externalErp])
}

enum Role {
  ADMIN // gestor da rede — acesso total
  STORE_MANAGER // gestor de loja — escopo restrito à própria filial
}

/// Usuário da plataforma. ADMIN enxerga toda a rede; STORE_MANAGER é
/// limitado à `storeId` (estoque, vendas e movimentações da sua loja).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(STORE_MANAGER)
  storeId      String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store            Store?           @relation(fields: [storeId], references: [id])
  decisions        DecisionRecord[]
  /// Tipos de card que este usuário pode decidir (COMPRA, REMANEJAMENTO,
  /// LIQUIDACAO). Vazio = todos — é o comportamento anterior, então nenhum
  /// usuário existente perde acesso na migração.
  allowedCardTypes String[]         @default([])

  @@index([role])
}

/// Vendedor / funcionário (Sellbie: rota `vendedores`, campo `funcionario`).
model Seller {
  id         String  @id @default(cuid())
  externalId String  @unique // funcionario
  name       String
  storeId    String?
  active     Boolean @default(true)

  includedAt DateTime? // dataInclusao
  syncedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  store Store? @relation(fields: [storeId], references: [id])
  sales Sale[]

  @@index([storeId])
}

/// Cor de produto (Sellbie: rota `cores`).
model Color {
  id         String  @id @default(cuid())
  externalId String  @unique
  name       String
  hex        String?

  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
}

/// Tamanho de produto (Sellbie: rota `tamanhos`).
model Size {
  id         String @id @default(cuid())
  externalId String @unique
  name       String

  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]
}

/// Produto (Sellbie: rota `produtos`, campo `prodCodigo`).
model Product {
  id          String   @id @default(cuid())
  externalId  String   @unique // prodCodigo
  sku         String?
  description String
  brand       String?
  category    String? // armação, lente, óculos de sol, acessório, etc.
  colorId     String?
  sizeId      String?
  price       Decimal? @db.Decimal(12, 2)
  cost        Decimal? @db.Decimal(12, 2)
  minStock    Int? // estoque mínimo por loja (dispara alerta de ruptura)
  active      Boolean  @default(true)

  includedAt DateTime? // dataInclusao
  syncedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  color       Color?              @relation(fields: [colorId], references: [id])
  size        Size?               @relation(fields: [sizeId], references: [id])
  stockItems  StockItem[]
  saleItems   SaleItem[]
  movements   InventoryMovement[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  assets      ProductAsset[]
  attributes  ProductAttribute?
  tryOnEvents TryOnEvent[]
  decisions   DecisionRecord[]

  @@index([category])
  @@index([brand])
}

/// Cliente (Sellbie: rota `clientes`, campo `cpfCnpj`).
model Customer {
  id         String  @id @default(cuid())
  externalId String  @unique
  document   String? // cpfCnpj
  name       String
  email      String?
  phone      String?
  city       String?
  state      String?

  includedAt DateTime? // dataInclusao
  syncedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  sales Sale[]

  @@index([document])
}

// ─── Estoque ─────────────────────────────────────────────────────────────────

/// Posição de estoque de um produto em uma loja (Sellbie: rota `estoque`).
/// `quantity` é o valor sincronizado da fonte; `available` reflete o filtro
/// `only_disp`. `reserved`/`onHand` são derivados das movimentações internas.
model StockItem {
  id        String @id @default(cuid())
  storeId   String
  productId String

  quantity  Int  @default(0) // quantidade vinda do Sellbie na última sync
  available Int  @default(0) // disponível (only_disp) na última sync
  reserved  Int  @default(0) // reservado por movimentações internas pendentes
  minStock  Int? // mínimo específico desta loja (sobrepõe o do produto/rede)

  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store   Store   @relation(fields: [storeId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([storeId, productId])
  @@index([productId])
}

// ─── Vendas ──────────────────────────────────────────────────────────────────

/// Venda (Sellbie: rotas `vendas` / `detalhesVendas`, campo `dataVenda`).
model Sale {
  id         String   @id @default(cuid())
  externalId String   @unique
  storeId    String?
  sellerId   String?
  customerId String?
  saleDate   DateTime
  total      Decimal  @db.Decimal(12, 2)
  discount   Decimal? @db.Decimal(12, 2)
  status     String?

  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  store    Store?     @relation(fields: [storeId], references: [id])
  seller   Seller?    @relation(fields: [sellerId], references: [id])
  customer Customer?  @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  payments Payment[]

  @@index([saleDate])
  @@index([storeId])
}

/// Item de uma venda (Sellbie: rota `detalhesVendas`).
model SaleItem {
  id         String   @id @default(cuid())
  externalId String?  @unique
  saleId     String
  productId  String?
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(12, 2)
  discount   Decimal? @db.Decimal(12, 2)
  total      Decimal  @db.Decimal(12, 2)

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

/// Pagamento de uma venda (Sellbie: rota `pagamentosVendas`).
model Payment {
  id           String    @id @default(cuid())
  externalId   String?   @unique
  saleId       String
  method       String? // dinheiro, cartão, pix, crediário...
  amount       Decimal   @db.Decimal(12, 2)
  installments Int?
  paidAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// ─── Movimentação interna (tempo real durante o dia) ─────────────────────────

enum MovementType {
  TRANSFER // transferência entre lojas
  SALE // saída por venda registrada internamente
  ADJUSTMENT // ajuste manual de estoque
  RETURN // devolução / entrada
}

enum MovementStatus {
  REQUESTED // solicitada por uma loja, aguardando aprovação da rede
  REJECTED // solicitação recusada
  PENDING // aprovada/registrada, reserva o saldo na origem
  CONFIRMED // efetivada no estoque interno
  CANCELLED // cancelada
  RECONCILED // já refletida pela sincronização da fonte
}

/// Movimentação de estoque feita dentro da plataforma ao longo do dia.
/// Permite operar em "tempo real" mesmo com a fonte disponível só às 06h:
/// o estoque exibido = base sincronizada + movimentações não reconciliadas.
model InventoryMovement {
  id           String         @id @default(cuid())
  type         MovementType
  status       MovementStatus @default(PENDING)
  productId    String
  fromStoreId  String? // origem (TRANSFER/SALE/ADJUSTMENT-)
  toStoreId    String? // destino (TRANSFER/RETURN/ADJUSTMENT+)
  quantity     Int
  reason       String?
  reference    String? // ex.: nº da venda/OS de origem
  createdBy    String? // usuário que registrou/solicitou
  approvedBy   String? // usuário que aprovou/rejeitou
  decisionNote String? // justificativa da aprovação/recusa

  createdAt    DateTime  @default(now())
  approvedAt   DateTime?
  confirmedAt  DateTime?
  reconciledAt DateTime?

  product   Product @relation(fields: [productId], references: [id])
  fromStore Store?  @relation("MovementFromStore", fields: [fromStoreId], references: [id])
  toStore   Store?  @relation("MovementToStore", fields: [toStoreId], references: [id])

  fiscalDocuments FiscalDocument[]

  @@index([status])
  @@index([productId])
  @@index([createdAt])
}

// ─── Planejamento & Compras ──────────────────────────────────────────────────

/// Prazo de ressuprimento por fornecedor (mapeado pela marca do produto).
/// Usado no planejamento para calcular o ponto de reposição e o prazo-limite
/// do pedido de cada item ("pedir até"). Sem registro, vale o prazo padrão.
/// Prazo de entrega POR FORNECEDOR. A chave é o campo `brand` do CDS, que
/// carrega o fornecedor ("LUXOTTICA BRASIL PRODUTOS OTICOS E ESPORTIVOS
/// LTDA"), e é essa mesma string que `supplierConfigResolver` procura.
model SupplierSetting {
  id           String @id @default(cuid())
  brand        String @unique
  leadTimeDays Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Grife fora do mix atual da rede (feedback 6.0 · item 03: "sugere grifes que
/// inclusive não fazem mais parte de nosso mix de produto"). Corta a sugestão
/// de compra; não corta a liquidação — descontinuado com saldo é exatamente o
/// que se quer escoar — nem o remanejamento.
///
/// TABELA PRÓPRIA, e não mais uma coluna em `SupplierSetting`, porque as duas
/// coisas são chaveadas por espaços de nome DIFERENTES e a confusão entre eles
/// deixava o recurso inerte:
///
///   · prazo de entrega é do FORNECEDOR — "Luxottica entrega em 30 dias";
///   · mix é da GRIFE — "a rede não trabalha mais Ray-Ban".
///
/// Enquanto as duas moraram na mesma linha, a tela oferecia para marcar as
/// linhas que ela sabia listar (fornecedores, via `Product.brand`) e o motor
/// procurava pelo que ele usa (`analysisBrand`, a grife da descrição). Medido
/// no catálogo real: das 16 linhas oferecidas na tela, 7 nunca casariam com
/// nada — e são justamente as de moda (Danyselle, Luxottica, Technos,
/// Marcolin, Safilo, Marchon), 160 produtos. As 9 que casavam eram de
/// laboratório, e só casavam por acaso: lente não tem grife na descrição, e
/// aí `analysisBrand` cai no fornecedor. As 63 grifes que o motor conhece —
/// RAY BAN, OAKLEY, ARNETTE, MIU MIU — não apareciam em lugar nenhum.
model BrandMix {
  id           String  @id @default(cuid())
  /// A GRIFE na forma NORMALIZADA por `normBrandKey` — maiúscula, sem acento,
  /// espaços colapsados —, para "Dolce & Gabbana" casar com "DOLCE E GABBANA".
  ///
  /// A leitura sempre comparou assim; a escrita gravava a string literal da
  /// tela, e as duas só concordavam por acaso. Grave por `setBrandMix`, que
  /// normaliza: gravar a forma literal aqui cria uma linha que a leitura
  /// enxerga mas o `deleteMany` da tela nunca acha.
  brand        String  @unique
  discontinued Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([discontinued])
}

enum PurchaseOrderStatus {
  SENT // enviado ao fornecedor (em trânsito)
  RECEIVED // mercadoria conferida e recebida
  CANCELLED
}

/// Pedido de compra registrado a partir do planejamento. O snapshot dos
/// itens fica em JSON (o pedido é um documento histórico, imutável após o
/// envio); enquanto SENT, as quantidades contam como "a caminho" e são
/// abatidas das próximas sugestões de compra.
model PurchaseOrderRecord {
  id           String              @id @default(cuid())
  supplier     String
  leadTimeDays Int
  status       PurchaseOrderStatus @default(SENT)
  items        Json // [{ productId, description, quantity, unitCost, total }]
  units        Int
  total        Decimal             @db.Decimal(12, 2)
  sentBy       String
  sentAt       DateTime            @default(now())
  expectedAt   DateTime? // sentAt + leadTimeDays
  receivedBy   String?
  receivedAt   DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([status])
  @@index([supplier])
}

// ─── Auditoria de sincronização ──────────────────────────────────────────────

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

/// Registro de cada execução de sincronização (por entidade ou geral).
model SyncRun {
  id             String     @id @default(cuid())
  entity         String // "all", "stores", "products", "stock", ...
  status         SyncStatus @default(RUNNING)
  startedAt      DateTime   @default(now())
  finishedAt     DateTime?
  recordsRead    Int        @default(0)
  recordsWritten Int        @default(0)
  window         String? // janela usada, ex.: "06:00-07:00"
  trigger        String? // "schedule", "boot", "manual"
  error          String?

  @@index([entity])
  @@index([startedAt])
}

// ─── E-commerce (venda online) ───────────────────────────────────────────────

/// Carrinho de compras (por usuário/sessão), sempre atrelado a uma loja de
/// origem do estoque.
model Cart {
  id        String     @id @default(cuid())
  userId    String?
  storeId   String
  status    String     @default("OPEN") // OPEN | CONVERTED | ABANDONED
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  store     Store      @relation(fields: [storeId], references: [id])
  items     CartItem[]

  @@index([userId])
  @@index([status])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

enum OrderStatus {
  CREATED // aguardando pagamento
  PAID // pagamento confirmado
  FULFILLED // separado/entregue
  CANCELLED
  REFUNDED
}

/// Pedido de venda online.
model Order {
  id           String      @id @default(cuid())
  number       String      @unique
  userId       String?
  storeId      String
  customerName String?
  status       OrderStatus @default(CREATED)
  subtotal     Decimal     @db.Decimal(12, 2)
  total        Decimal     @db.Decimal(12, 2)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  paidAt       DateTime?

  // Write-back ao ERP (POST /cds/inserirvenda) — semântica de outbox:
  // attemptedAt marca o claim da tentativa (anti envio duplo concorrente);
  // exportedAt marca sucesso; error guarda a última falha (retry até o teto
  // de tentativas). attemptedAt sem exportedAt e sem error = envio
  // interrompido: só reprocessa via retryStuck após conferir o ERP.
  erpExportedAt        DateTime?
  erpExportAttemptedAt DateTime?
  erpExportAttempts    Int       @default(0)
  erpExportError       String?

  store   Store          @relation(fields: [storeId], references: [id])
  items   OrderItem[]
  payment OnlinePayment?

  fiscalDocuments FiscalDocument[]

  @@index([status])
  @@index([storeId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  total      Decimal @db.Decimal(12, 2)
  movementId String? // reserva de estoque associada (InventoryMovement)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

enum OnlinePaymentStatus {
  PENDING
  APPROVED
  DECLINED
  REFUNDED
}

/// Pagamento online do pedido, abstraído do gateway (provider).
model OnlinePayment {
  id         String              @id @default(cuid())
  orderId    String              @unique
  provider   String // "mock" | "mercadopago" | ...
  method     String? // PIX | CARD | BOLETO
  status     OnlinePaymentStatus @default(PENDING)
  amount     Decimal             @db.Decimal(12, 2)
  externalId String? // id no gateway
  qrCode     String? // payload PIX (mock)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─── Provador Virtual (AR) ───────────────────────────────────────────────────

enum AssetType {
  GLB_3D // modelo 3D em escala real (projeção exata)
  OVERLAY_2D // overlay 2D (fallback)
}

enum AssetStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Asset de AR de um produto (modelo 3D/2D + metadados de encaixe).
model ProductAsset {
  id        String      @id @default(cuid())
  productId String
  type      AssetType
  url       String
  fit       Json? // { frameWidth, bridgeWidth, templeLength, lensHeight, scale, ... }
  version   Int         @default(1)
  status    AssetStatus @default(PUBLISHED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([status])
}

/// Telemetria de prova virtual (alimenta o funil no BI). Sem dados biométricos.
model TryOnEvent {
  id         String   @id @default(cuid())
  productId  String
  storeId    String?
  userId     String?
  durationMs Int?
  converted  Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

/// Documento fiscal emitido a partir de um pedido (NFC-e) ou transferência (NF-e).
enum FiscalDocType {
  NFE
  NFCE
}

enum FiscalDocStatus {
  PROCESSING
  AUTHORIZED
  REJECTED
  CANCELLED
}

model FiscalDocument {
  id         String          @id @default(cuid())
  type       FiscalDocType
  status     FiscalDocStatus @default(PROCESSING)
  /// Referência única no provedor — garante idempotência da emissão.
  ref        String          @unique
  orderId    String?
  movementId String?
  provider   String
  accessKey  String? // chave de acesso (44 dígitos) quando autorizada
  number     String?
  series     String?
  danfeUrl   String?
  xmlUrl     String?
  error      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  order    Order?             @relation(fields: [orderId], references: [id])
  movement InventoryMovement? @relation(fields: [movementId], references: [id])

  @@index([orderId])
  @@index([movementId])
  @@index([status])
}

// ─── Governança da decisão (Onda 1 · trilha TB) ──────────────────────────────

enum DecisionOutcome {
  APPROVED // gestor aprovou o card — a ação foi (ou será) executada
  REJECTED // gestor recusou, com justificativa
}

/// Registro imutável de uma decisão tomada sobre um card do Planejamento.
/// É a trilha de auditoria: quem decidiu, quando, com que justificativa e
/// qual era o impacto em R$ no momento da decisão. Nunca se atualiza uma
/// linha — decidir de novo cria outra, e a mais recente vale.
model DecisionRecord {
  id         String          @id @default(cuid())
  /// ID do card (determinístico: mesmo card gera o mesmo id entre execuções).
  cardId     String
  /// Tipo do card no momento da decisão (BUY / REBALANCE / LIQUIDATE…).
  cardType   String
  outcome    DecisionOutcome
  /// Texto livre do gestor. Obrigatório na recusa pela regra de negócio.
  note       String?
  /// Impacto financeiro (R$) que o card exibia quando foi decidido — o valor
  /// muda a cada nova execução do motor, então congelamos o da decisão.
  impact     Decimal         @db.Decimal(14, 2)
  /// Quando o card foi gerado — permite medir o tempo até a decisão (SLA).
  cardSeenAt DateTime?
  productId  String?
  storeId    String?
  decidedBy  String
  decidedAt  DateTime        @default(now())

  user    User     @relation(fields: [decidedBy], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  store   Store?   @relation(fields: [storeId], references: [id])

  @@index([cardId])
  @@index([decidedAt])
  @@index([decidedBy])
  @@index([outcome, decidedAt])
}

// ─── Lote de geração (Onda 1 · trilha TB) ────────────────────────────────────

enum BatchSource {
  CRON // gerado pela sincronização agendada (06h) — o caso normal
  MANUAL // sync disparado à mão (botão do painel ou linha de comando)
}

/// Uma execução do motor de decisão. O motor recalcula tudo a cada
/// sincronização; sem registrar o lote não há como responder "quando isso foi
/// calculado?" nem "o que apareceu de novo hoje?" — as duas primeiras
/// perguntas que o gestor faz ao abrir a tela de manhã.
model GenerationBatch {
  id            String      @id @default(cuid())
  generatedAt   DateTime    @default(now())
  source        BatchSource
  /// Gatilho do sync que originou o lote ('schedule', 'manual', 'boot').
  trigger       String
  /// Janela de dias que o motor usou.
  days          Int
  cardsTotal    Int
  /// Cards que nunca haviam aparecido em lote anterior.
  cardsNew      Int
  compra        Int
  remanejamento Int
  liquidacao    Int
  /// Impacto somado (R$) de todos os cards do lote.
  impactTotal   Decimal     @db.Decimal(14, 2)

  sightings CardSighting[]

  @@index([generatedAt])
}

/// Uma linha por CARD distinto, não por aparição: o id do card é
/// determinístico, então o mesmo card reaparece em todo lote enquanto a
/// condição persistir. Guardar a PRIMEIRA aparição é o que permite medir a
/// idade real do card e o SLA de decisão — `DecisionRecord.cardSeenAt` passa a
/// vir daqui, do servidor, em vez de o cliente informar.
model CardSighting {
  cardId      String   @id
  cardType    String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  /// Em quantos lotes o card já apareceu — card que reaparece há semanas sem
  /// decisão é o sintoma que o painel de governança precisa mostrar.
  timesSeen   Int      @default(1)
  /// Lote da PRIMEIRA aparição (o "lote de geração" do card).
  batchId     String

  batch GenerationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([firstSeenAt])
  @@index([lastSeenAt])
}

/// Tudo o que sabemos de uma peça e que NÃO vem do endpoint de produtos do ERP.
///
/// Duas fontes distintas alimentam esta tabela, por chaves distintas, e por
/// isso cada uma carrega a própria procedência:
///
///  · os CADASTROS DE FORNECEDOR (Luxottica, Marchon, …) trazem gênero,
///    formato, material, medidas e a marcação de best-seller. Casam pela
///    decomposição da descrição — `Referência + Código da Cor + Tamanho da
///    lente`, que reconstrói a "Barra CDS" do fornecedor. Não casam por GTIN
///    nem por código: medi, e os dois dão zero.
///  · a PLANILHA DE PROMOÇÃO DO CDS traz o teto de desconto por peça, e essa
///    casa direto por `externalId` (o `codigo_base`).
///
/// Um produto pode ter só uma das duas. Por isso as colunas de procedência são
/// separadas: dizer "importado em" sobre uma linha que só tem metade do dado
/// esconde exatamente o que precisa aparecer.
model ProductAttribute {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // ── Cadastro do fornecedor ────────────────────────────────────────────────
  /// A chave que casou, guardada para auditoria do próximo import.
  barraCds      String?
  referencia    String?
  gtin          String?
  /// Marca como o FORNECEDOR a escreve. NÃO substitui `analysisBrand`, que
  /// continua sendo a grife extraída da descrição — são espaços de nome
  /// diferentes, e confundi-los já custou uma entrega aqui.
  marcaCatalogo String?
  /// Feminino · Masculino · Unisex · Menina · Menino
  genero        String?
  /// Retangular, Quadrado, Gatinho, Phantos… — é o "tipo de olho" do feedback.
  formato       String?
  material      String?
  cor           String?
  codigoCor     String?
  tamanhoLente  Int?
  alturaLente   Int?
  tamanhoPonte  Int?
  tamanhoHaste  Int?
  /// Marcação oficial do fornecedor. O motor cruza com giro real antes de usar.
  bestSeller    Boolean @default(false)
  imagemUrl     String?

  fonteCadastro String?
  cadastroEm    DateTime?

  // ── Promoção do CDS ───────────────────────────────────────────────────────
  /// Teto COMERCIAL de desconto, definido pelo CDS. Distinto do `maxPct` que o
  /// motor calcula a partir da margem: aquele diz até onde a conta fecha, este
  /// diz até onde a rede tem permissão de ir.
  maxDiscountPct Decimal?  @db.Decimal(5, 2)
  fonteDesconto  String?
  descontoEm     DateTime?

  @@index([bestSeller])
  @@index([genero])
  @@index([marcaCatalogo])
}
